# Telegram Bot Token (required)
BOT_TOKEN=your_telegram_bot_token_here

# Development Bot Token (used when NODE_ENV=development)
BOT_TOKEN_DEV=your_dev_bot_token_here

# Environment (development | production)
NODE_ENV=production

# Set to 'disabled' to disable the bot
BOT_STATUS=

# Admin Telegram chat ID, the only chat /stats answers (optional)
ADMIN_CHAT_ID=

# Download budget for one file, milliseconds (default: 20000)
TIMEOUT_MS=20000

# Conversion budget for one file, milliseconds (default: 10000)
CONVERT_TIMEOUT_MS=10000

# Documents converted at the same time (default: 4)
MAX_CONCURRENT=4

# Ceilings on what a ZIP container claims to hold, bytes
# (defaults: 40 MB of markup, 200 MB in total)
MAX_XML_BYTES=41943040
MAX_UNCOMPRESSED_BYTES=209715200

# Longest Markdown still shown in the document caption, characters
# (default: 900, Telegram caps a caption at 1024)
CAPTION_LIMIT=900

# OCR. Set to 'false' to reject pictures instead of reading them
OCR_ENABLED=true

# Tesseract language codes joined by '+'. Left-to-right scripts only, see README
OCR_LANGUAGE=eng+rus

# Pages read from one document (default: 15)
OCR_MAX_PAGES=15

# OCR budget for one file, milliseconds (default: 60000)
OCR_TIMEOUT_MS=60000

# Rendering resolution (default: 150)
OCR_DPI=150

# Tesseract threads within one document (default: 2)
OCR_WORKERS=2

# Pictures read at the same time (default: 1)
OCR_MAX_CONCURRENT=1

# Pictures allowed to wait before the rest are refused (default: 3)
OCR_QUEUE_LIMIT=3

# Pixels a picture or a rendered page may declare (default: 40000000)
OCR_MAX_PIXELS=40000000

# Resident megabytes an OCR worker may reach before it is killed (default: 400)
OCR_MAX_RSS_MB=400

# Average confidence below which the output carries a warning (default: 0.75)
OCR_MIN_CONFIDENCE=0.75
